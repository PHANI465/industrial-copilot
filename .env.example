# Copy this file to `.env.local` and set your values.
# `.env.local` is gitignored — never commit it or paste keys into tracked files.

OPENAI_API_KEY=

# Optional: email when equipment hits CRITICAL (https://resend.com)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Industrial Copilot <onboarding@resend.dev>
# ALERT_SUBSCRIBER_EMAILS=ops@example.com,manager@example.com
# Optional JSON: per-email filters (tag / area / type). Empty arrays = all assets for that email.
# ALERT_SUBSCRIBER_RULES=[{"email":"hp@example.com","areas":["HP Separation"]},{"email":"pumps@example.com","types":["pump"]}]
